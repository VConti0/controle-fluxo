rules_version = '2';

// The app never touches Firestore directly: balances, purchases and bets go
// through the Cloud Functions (which use the Admin SDK and bypass these
// rules). Players may read their own profile; nobody may write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /rounds/{round} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
