{
  "name": "escape-ball-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "copy-data": "node scripts/copy-data.mjs",
    "build": "npm run copy-data && tsc",
    "test": "npm run copy-data && vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-escape-ball \"vitest run --config vitest.rules.config.mts\"",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore --project demo-escape-ball",
    "deploy": "firebase deploy --only functions,firestore:rules"
  },
  "dependencies": {
    "@googleapis/androidpublisher": "^42.3.1",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  }
}
